{
	"name": "phoenix-worker",
	"version": "0.0.0",
	"description": "Cloudflare Worker built with Hono and Bun",
	"scripts": {
		"dev": "wrangler dev src/index.ts",
		"deploy": "wrangler deploy src/index.ts",
		"tail": "wrangler tail",
		"test": "bun test",
		"lint": "biome check .",
		"lint:fix": "biome check --write . && biome format --write .",
		"cli": "bun run cli/index.ts"
	},
	"dependencies": {
		"hono": "^4.6.13"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.11",
		"@cloudflare/workers-types": "^4.20241127.0",
		"wrangler": "^3.94.0"
	}
}
